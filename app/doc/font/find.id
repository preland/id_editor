// Font path resolution: extract argument, resolve, return path or abort.

ed_font_arg(int argc, string[] argv) {
  string explicit = "";
  if(argc > 2) {
    explicit = argv[2];
  }
  string ret = ed_font_find(explicit);
} return string ret;
(3, ["editor", "file", "Arial"]):("Arial")
given odt_init3 given ed_font_test_dirs (2, ["editor", "file"]):("test_assets/DejaVuSans.ttf")

ed_font_find(string explicit) {
  string ret = "";
  if(explicit != "" && explicit != "--ppm") {
    ret = explicit;
  } else {
    ret = ed_font_resolve();
  }
} return string ret;
("Arial"):("Arial")
given odt_init3 given ed_font_test_dirs (""):("test_assets/DejaVuSans.ttf")

ed_font_resolve() {
  string doc = ed_font_doc0();
  string ret = ed_font_try_resolve(doc);
} return string ret;
