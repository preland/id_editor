// Candidate paths for a font name, and the name-to-filename squash.
//
// `id` cannot list a directory, so a font is found by probing a fixed list of
// places rather than by searching. That is the same bargain the test harness
// makes in idc/tests/editor_ras.sh, and the reason the list is short.

ed_font_try_prefixes(string name) {
  string p = ed_font_try_suff(name, "/run/current-system/sw/share/X11/fonts/");
  p = ed_font_more(p, name, "/usr/share/fonts/TTF/");
  p = ed_font_more(p, name, "/usr/share/fonts/truetype/");
} return string p;
("DejaVuSans"):("/run/current-system/sw/share/X11/fonts/DejaVuSans.ttf")
("NonExistent"):("")

ed_font_try_suff(string name, string prefix) {
  string p = prefix + name + ".ttf";
  if(fs_size(p) < 0) {
    p = prefix + name + "-Regular.ttf";
  }
  if(fs_size(p) < 0) {
    p = "";
  }
} return string p;
("DejaVuSans", "/run/current-system/sw/share/X11/fonts/"):("/run/current-system/sw/share/X11/fonts/DejaVuSans.ttf")
("NonExistentFont", "/tmp/"):("")

// An ODT names a face the way a person writes it -- "DejaVu Sans" -- and a
// file is named the way a filesystem allows -- DejaVuSans.ttf. Dropping the
// spaces is what turns one into the other, and without it the document's own
// font never matches and every render silently falls back.
ed_font_squash(string name) {
  string out = "";
  int i = 0;
  while(i < len(name)) {
    out = ed_font_keep(out, name, i);
    i = i + 1;
  }
} return string out;
("DejaVu Sans"):("DejaVuSans")
("Liberation"):("Liberation")
