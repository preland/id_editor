// A substring.
//
// Through the flat store rather than a loop of `+`, for the reason
// docs/FRICTION.md 9 gives: appending a character at a time is quadratic. The
// round trip copies the whole string once, which is the wrong shape for a long
// one and exactly right for clipping a line of a listing.
ed_cut(string s, int lo, int hi) {
  word mem_of_str_v = mem_of_str(s);
  string ret_s = str_of_mem(mem_of_str_v + lo, hi - lo);
} return string ret_s;
("hello", 0, 3): ("hel")
("hello", 2, 5): ("llo")

// The write side of the same round trip: bytes poked into a fresh block,
// then read back as the string they spell. Split out of ed_str so that
// function's own three actions stay under the limit.
ed_str_out(int[] xs, word a, int n) {
  ed_poke(xs, a, 0);
  string ret_s = str_of_mem(a, n);
} return string ret_s;
given xml_buf_fixture ([72, 105], (import xml_buf), 2): ("Hi")
given xml_buf_fixture ([], (import xml_buf), 0): ("")

// A real file on disk, for ed_read: it goes through fs_open/fs_read like any
// document does, so there is no way to test it without one. Wraps
// ed_out_fixture too, only so this fixture's own cases below have something
// already exported and safe to check alongside the file it writes. Each
// run's file is unique (fs_mktemp); ed_read_fixture_size in out/fixture.id
// removes it once read, so a case that reads back through it leaves nothing
// behind.
ed_read_fixture() {
  ed_out_fixture();
  export string ed_read_path = fs_mktemp("ed_read_fixture_", 0);
  int h = fs_open(ed_read_path, "w");
} chain () {
  int[] bytes = [97, 98, 99];
  int w = fs_write(h, bytes, 3);
  int c = fs_close(h);
} return void;
