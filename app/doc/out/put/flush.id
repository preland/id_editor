// The buffer ed_bytes filled, written out. Split off so ed_bytes -- which
// already spends its three actions filling the buffer one character at a
// time -- has somewhere to hand the result.
ed_bytes_out(int[] buf) {
  int ed_fd_v = ed_fd();
  int len_v = len(buf);
  fs_write(ed_fd_v, buf, len_v);
} return void;
