// One row: three bytes a pixel, into the same buffer every time. The buffer is
// filled on the first row and overwritten on every one after, because `id` has
// no way to empty a list and re-declaring it would rebind a name held above.
ed_prow(int y) {
  ed_grow_row();
  ed_fill(y, 0);
  ed_prow_out();
} return void;
