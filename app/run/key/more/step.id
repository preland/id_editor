// Clamping the caret, the document's length, and backspace.

ed_step2(int k, int n) {
  if(k < 0) {
    k = 0;
  } else if(k > n) {
    k = n;
  }
  ed_seek(k);
} return void;
given ed_cur_init (-5, 10):() then calls ed_seek:(0)
given ed_cur_init (15, 10):() then calls ed_seek:(10)

// How many code points the document holds, which is one past the last
// position the caret may take.
ed_total() {
  int n = odt_runs();
  int ret_i = ed_pre(n);
} return int ret_i;
given ed_step_fixture ():(0) then calls ed_pre:(0)
given ed_step_fixture2 ():(2) then calls ed_pre:(1)

// Backspace is the character before the caret, which is the character at the
// caret once the caret has stepped back. Doing it in that order means the
// program contains one delete rather than two.
ed_back() {
  int k = ed_car();
  if(k > 0) {
    ed_seek(k - 1);
    ed_erase();
  }
} return void;
given ed_step_fixture ():() then calls ed_erase:[0]
given ed_step_fixture2 ():() then calls ed_erase:[1]
