ed_go(int argc, string[] argv) {
  ed_font_dirs_init();
  ed_load(argv[1]);
  string font_path = ed_font_arg(argc, argv);
} chain (int argc, string[] argv) {
  ed_go_font(argc, argv, font_path);
} return void;
