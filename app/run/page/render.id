// The font, read and loaded, before the page that needs its metrics is laid
// out.
ed_go_font(int argc, string[] argv, string font_path) {
  int[] ed_read_v = ed_read(font_path);
  tt_load(ed_read_v);
  ed_render(argc, argv);
} return void;
