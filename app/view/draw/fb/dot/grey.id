// The colour already there, so a glyph drawn over another darkens rather than
// replacing -- which is what bold needs, being the same glyph drawn twice a
// pixel apart.
ed_at(int x, int y) {
  int v = 16777215;
  if(x >= 0 && x < ed_w() && y >= 0 && y < ed_h()) {
    v = (import ed_fb)[y * ed_w() + x];
  }
} return int v;
