// The page in a window.
//
// The same pixels the image file gets: the graphics backend takes a
// framebuffer of 0xRRGGBB, row-major, which is what the renderer already
// produced. Nothing here draws -- it presents.
//
// A machine with no display makes gfx_open return 0, and the loop never
// starts. Every windowed program in this tree has had that bug at least once:
// gfx_poll then returns -1 forever and a loop that started unconditionally
// never ends.

ed_win() {
  int ed_w_v = ed_w();
  int ed_h_v = ed_h();
  ed_win_out(ed_w_v, ed_h_v);
} return void;
given win_bound_fixture ():() then calls ed_win_out:(0, 99)
given win_bound_fixture ():() then calls ed_cur_init:[1]

ed_frames(int ok, int v) {
  while(ok == 1 && ed_live(v) == 1) {
    v = ed_frame();
  }
  gfx_close();
} return void;
(0, 0):()
(1, -2):()

// Escape or the window's close button. Not q: q is a letter, and a letter
// is now something the document can be given rather than a command.
ed_live(int v) {
  int n = 1;
  if(v == 0 - 2 || v == 27) {
    n = 0;
  }
} return int n;
(-2):(0)
(27):(0)
(1):(1)
