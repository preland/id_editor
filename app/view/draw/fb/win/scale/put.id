// The choice, and the path that re-renders.
//
// Two things make a frame stale: the window is a different size than the page
// was drawn at, or a keystroke changed the document. Everything else presents
// the pixels it already has, because laying a document out is not cheap and
// presenting is.
//
// Re-rendering resets ed_dim to the size it drew at and lowers the stale flag,
// so the next frame finds the sizes equal, finds nothing changed, and takes the
// direct path. The re-lay therefore happens once per resize and once per
// keystroke rather than once per frame.

ed_present3(int w, int h, int pw, int ph) {
  if(w == pw && h == ph && ed_dirty() == 0) {
    gfx_present((import ed_fb));
  } else {
    ed_rerender(w, h);
  }
} return void;
given setup_page given ed_cur_init given ed_flush given lay_real_fixture (10, 20, 10, 20):() then calls ed_rerender:[0]
given setup_page given ed_cur_init given lay_real_fixture (10, 20, 10, 20):() then calls ed_rerender:(10, 20)

ed_rerender(int w, int h) {
  int lw = ed_lay_w(w);
  lay_doc(lw);
  ed_redraw(w, h);
} return void;
given setup_page given ed_cur_init given lay_real_fixture (10, 20):() then calls ed_redraw:(10, 20)
given setup_page given ed_cur_init given lay_real_fixture (640, 480):() then calls ed_redraw:(640, 480)

ed_redraw(int w, int h) {
  ed_draw(w, h);
  ed_bar();
  ed_flush();
} return void;
