// The choice, and the path that re-renders.
//
// Re-rendering resets ed_dim to the size it drew at, so the next frame finds
// the sizes equal and takes the direct path. The re-lay therefore happens once
// per resize rather than once per frame, with no state of its own to keep.

ed_present3(int w, int h, int pw, int ph) {
  if(w == pw && h == ph) {
    gfx_present((import ed_fb));
  } else {
    ed_rerender(w, h);
  }
} return void;

ed_rerender(int w, int h) {
  int lw = ed_lay_w(w);
  lay_doc(lw);
  ed_redraw(w, h);
} return void;

ed_redraw(int w, int h) {
  ed_draw(w, h);
  gfx_present((import ed_fb));
} return void;
