// Presenting a frame at whatever size the window is now.
//
// When the window size differs from the page framebuffer size, the page is
// re-laid and re-drawn at the window's size. When it matches, the page buffer
// is presented directly without resampling.

ed_present_frame() {
  int w = gfx_width();
  int h = gfx_height();
  ed_present2(w, h);
} return void;

ed_present2(int w, int h) {
  int pw = ed_w();
  int ph = ed_h();
  ed_present3(w, h, pw, ph);
} return void;
