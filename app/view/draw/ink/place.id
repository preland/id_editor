// Where a pixel of the glyph lands, and how many times.
//
// Bold is the glyph drawn twice a pixel apart and italic is it sheared, both
// of which are what a renderer does when the face it wants is not the face it
// has. A document naming DejaVu Serif Bold and a program given DejaVu Sans
// gets an honest approximation rather than the wrong weight silently.
ed_place(int i, int x, int y, int v) {
  int at = (import lay_x)[i] / 64 + ras_bx() + x + ed_lean(i, y);
  ed_place_out(i, at, y, v);
} return void;
