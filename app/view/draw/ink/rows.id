// The glyph's bitmap, row by row. Its origin is the pen and the baseline:
// ras_bx is the left bearing and ras_by the rows above the baseline, so the
// top-left of the bitmap is left of the pen by one and above the baseline by
// the other.
ed_rows(int i, int y) {
  while(y < ras_h()) {
    ed_row(i, y, 0);
    y = y + 1;
  }
} return void;
given ed_ink_fixture given setup_page (0, 0):() then calls ed_row:[10]
given ed_ink_fixture given setup_page (0, 5):() then calls ed_row:[5]

ed_row(int i, int y, int x) {
  while(x < ras_w()) {
    ed_dot(i, x, y);
    x = x + 1;
  }
} return void;
given ed_ink_fixture given setup_page (0, 0, 0):() then calls ed_dot:[6]
given ed_ink_fixture given setup_page (0, 0, 3):() then calls ed_dot:[3]

ed_dot(int i, int x, int y) {
  int v = ras_cov(x, y);
  ed_place(i, x, y, v);
} return void;
given ed_ink_fixture given setup_page (0, 0, 0):() then calls ed_place:[1]
given ed_ink_fixture given setup_page (1, 3, 4):() then calls ed_place:[1]
