// The advance ed_place needs found, and the pen moved past it. Split out of
// lay_emit so that function's own actions stay under the limit.
lay_emit_out(int g, int r) {
  int lay_pt_v = lay_pt(r);
  int lay_adv_v = lay_adv(g, lay_pt_v);
  lset((import lay_pen), 0, (import lay_pen)[0] + lay_adv_v);
} return void;
