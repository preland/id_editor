// Layout state for a case that reads it. lay_init returns int, so it cannot
// itself be a `given` (a setup returns void); this discards the result and
// chains into lay_init2/lay_init3, which declare the rest. odt_init_fixture
// comes with it so the document readers a layout case reaches are live too.
lay_fixture() {
  int r = lay_init();
  odt_init_fixture();
} return void;
