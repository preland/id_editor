// The whole document, top to bottom. The pen starts at the left margin and
// the first baseline, and every paragraph leaves it at the start of the next
// line -- so a paragraph break is a line break plus nothing, which is what an
// empty paragraph needs it to be.

lay_doc(int w) {
  lay_init();
  int lay_lead_v = lay_lead(12);
  lay_doc_out(w, lay_lead_v);
} return void;
given lay_doc_fixture (100):() then calls lay_paras:(100, 0) then calls lay_run:[0]
given lay_full_fixture (100):() then calls lay_paras:(100, 0) then calls lay_run:(100, 0)

lay_paras(int w, int i) {
  while(i < odt_paras()) {
    lay_para(w, i);
    i = i + 1;
  }
} return void;
given lay_row_fixture (1000, 0):() then calls lay_para:(1000, 0) then calls lay_para:[1]
given lay_row_fixture (1000, 1):() then calls lay_para:[0]

lay_para(int w, int i) {
  lset((import lay_pen), 0, 0);
  lay_runs(w, i, 0);
} return void;
given lay_row_fixture (1000, 0):() then calls lay_runs:(1000, 0, 0)
given lay_row_fixture (2000, 0):() then calls lay_runs:(2000, 0, 0)
