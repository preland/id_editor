// The one place a run's text changes. Every edit ends here, which is why the
// page can be marked stale here and nowhere else.
ed_set(int r, string t) {
  sset((import odt_txts), r, t);
  ed_dirt(1);
} return void;
given ed_step_fixture2 (0, "hi2"):() then ed_dirty:(1)
given ed_step_fixture2 (0, ""):() then ed_dirty:(1)

// The byte offset within run r that code point k lands on.
ed_off_of(int r, int k) {
  int j = k - ed_pre(r);
  string s = odt_run_text(r);
  int ret_i = ed_boff(s, j);
} return int ret_i;
