
ed_run(int r) {
  string key = odt_run_style(r);
  string ed_face_v = ed_face(key);
  ed_run_out(key, r, ed_face_v);
} return void;
given odt_doc_fixture (0):() then calls ed_run_out:("T1", 0, "bold")
given ed_step_fixture2 (0):() then calls ed_run_out:("T1", 0, "bold")

// Which face a style asks for, in one word, so a line of this listing is one
// line wide.
ed_face(string key) {
  string s = "regular";
  if(odt_bold(key) == 1) {
    s = "bold";
  } else if(odt_italic(key) == 1) {
    s = "italic";
  }
} return string s;
given odt_init ("unknown"):("regular") then calls odt_bold:("unknown")
given odt_init ("unknown"):("regular") then calls odt_italic:("unknown")

// A run's first sixty characters. A paragraph is one run and a run is a
// paragraph's worth of text, so printing them whole makes the listing
// unreadable rather than informative.
ed_clip(string s) {
  string t = s;
  if(len(s) > 60) {
    t = ed_cut(s, 0, 57) + "...";
  }
} return string t;
("hello"):("hello")
("the quick brown fox jumps over the lazy dog runs very fast home town"):("the quick brown fox jumps over the lazy dog runs very fas...")
