// The document as text, with what each run is meant to look like.
//
// This is the seam between reading a document and drawing one: everything
// above it is the file, everything below is pixels. It stays because it is the
// only view that says what the *model* holds, and a wrong font size is far
// easier to see here than in an anti-aliased glyph.

ed_show() {
  int i = 0;
  while(i < odt_paras()) {
    ed_para(i);
    i = i + 1;
  }
} return void;
given ed_step_fixture ():() then prints:("")
given ed_step_fixture ():() then calls ed_para:[0]

ed_para(int i) {
  int odt_runs_of_v = odt_runs_of(i);
  print("[" + i + "] " + odt_runs_of_v + " run(s)");
  ed_runs(i, 0);
} return void;
given odt_doc_fixture (0):() then prints:("[0] 1 run(s)\n    bold 12pt DejaVu Sans: hi\n")
given ed_step_fixture2 (0):() then calls ed_runs:(0, 0)

ed_runs(int i, int k) {
  while(k < odt_runs_of(i)) {
    int odt_run_at_v = odt_run_at(i, k);
    ed_run(odt_run_at_v);
    k = k + 1;
  }
} return void;
