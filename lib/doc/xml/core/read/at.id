// Whether the byte at a position is whitespace, without naming that byte
// itself: a `while` reads this once per iteration, and a name for the byte
// would be stale after the first one moves past it.
xml_space_at(int i) {
  int c = xml_ch(i);
  int ok = chr_is_space(c);
} return int ok;
