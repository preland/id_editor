// xml_mem has a legal `given`. xml_open is the only initialiser and it takes
// the document as a parameter, which a setup may not (docs/TESTS.md): without
// a wrapper like this one, every reader of the scanner is untestable.
xml_doc_fixture() {
  xml_open("<a>hi</a>");
} return void;
