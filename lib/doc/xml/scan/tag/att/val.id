// An attribute value: a quoted run, entities and all.

// Both quote characters are legal in XML and each ends only on its own kind,
// so which one opened the value is carried into the scan.
xml_aval2(int j, int i) {
  int hi = xml_len();
  if(xml_ch(j) == 34 || xml_ch(j) == 39) {
    int xml_ch_v = xml_ch(j);
    hi = xml_aval3(j + 1, xml_ch_v, i);
  } else {
    xml_fail("expected a quoted attribute value", i);
  }
} return int hi;
given xml_empty_fixture (0, 0):(0)
given xml_doc_fixture (0, 0):(9)

// j is the first byte of the value, c the quote that has to end it.
xml_aval3(int j, int c, int i) {
  int hi = xml_upto(j, c);
  int ret_i = xml_aput(j, hi, i);
} return int ret_i;
given xml_doc_fixture (1, 34, 0):(9)
given xml_empty_fixture (0, 34, 0):(0)

// Running off the end of the input inside a value is a document that stops
// mid-tag, and there is nothing sensible to do with what came before it.
xml_aput(int j, int hi, int i) {
  int m = xml_len();
  if(xml_ch(hi) < 0) {
    xml_fail("unterminated attribute value", i);
  } else {
    m = xml_aput2(j, hi);
  }
} return int m;
given xml_empty_fixture (0, 0, 0):(0)
given xml_doc_fixture (0, 9, 0):(9)
