// The last two continuation bytes, which the three- and four-byte forms share.
// Shared rather than repeated: two functions with one body are a compile error
// in this language, so a near-duplicate is not a style question here.

xml_tail(int[] row, word a, int v) {
  xml_emit(row, a, 128 + (v / 64) % 64);
  xml_emit(row, a, 128 + v % 64);
} return void;
given xml_buf_fixture ([0, 0], (import xml_buf), 0):([0, 2]) then xml_buf_first:(128)
given xml_buf_fixture ([0, 0], (import xml_buf), 4095):([0, 2]) then xml_buf_first:(191)

// A writable buffer, for the encoders that take a caller-supplied address.
// docs/TESTS.md's `given buf_setup ((import gb))` shape: a setup allocates and
// exports the address, and the case hands it in by name. Without one, every
// function here pokes at address 0 and traps, which is why they were read as
// untestable.
xml_buf_fixture() {
  export word xml_buf = alloc(64);
  poke8(xml_buf, 65);
} return void;
():() then xml_buf_first:(65)
given xml_buf_hi ():() then xml_buf_first:(65)

// The first byte of that buffer, so a case can see what an encoder wrote.
xml_buf_first() {
  int c = peek8((import xml_buf));
} return int c;
given xml_buf_fixture ():(65)
