// The letter half of a hexadecimal digit, already lowercased by xml_hv.
// Written as its own function only because xml_hv's `if` and `else` and the
// local they assign to are already three actions.

xml_hv2(int c) {
  int v = -1;
  if(c >= 97 && c <= 102) {
    v = c - 87;
  }
} return int v;
(97):(10)
(102):(15)
(50):(-1)

