// The device column a crossing falls in, before it is clamped onto the
// bitmap: ras_xat is in device sixty-fourths from the origin, and ras_bx is
// whole pixels of left bearing, hence the *64 to bring the two to the same
// unit.
ras_add_col(int i, int y) {
  int ras_xat_v = ras_xat(i, y);
  int off = ras_add_off(ras_xat_v);
} return int off;
given ras_glyph_fixture (0, 288):(0)
given ras_glyph_fixture2 (0, 288):(137)

ras_add_off(int x) {
  int ras_bx_v = ras_bx();
  int ras_w_v = ras_w();
  int n = fx_clamp(x - ras_bx_v * 64, 0, ras_w_v * 64);
} return int n;
given ras_glyph_fixture (100):(100)
given ras_glyph_fixture (-50):(0)
given ras_glyph_fixture (10000):(576)
