given ras_glyph_fixture2 given ras_buf_fixture (0, 2, (import rastab), (import rasrow)):(3) then calls ras_samp_scan:[1]

ras_cuts(int y, int[] tab) {
  int i = 0;
  while(i < len((import rasy0))) {
    i = ras_cross(i, y, tab);
  }
} return void;
