// The pen's position, before the cursor cells are set.
ras_at_pen(int[] buf, int m) {
  int ras_dx_v = ras_dx(m);
  int ras_dy_v = ras_dy(m);
  ras_from(buf, ras_dx_v, ras_dy_v);
} return void;
