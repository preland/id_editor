ras_dumpr_out(string[] parts, string s, string t, int r) {
  string str_join_v = str_join(parts, " ");
  print("cov " + s + " " + t + " " + r + " " + str_join_v);
  int ret_i = r + 1;
} return int ret_i;
([], "A", "B", 0):(1) then prints:("cov A B 0 \n")
(["1", "2"], "X", "Y", 5):(6) then prints:("cov X Y 5 1 2\n")
