// ras_selftest -- the rasteriser's answers, printed so that a reference
// implementation can be asked the same questions and the two diffed. It
// lives in the module for the reason tt_selftest gives: a shell script has
// no way to call an `id` function, so the smallest thing that can exercise
// ras_scale is a program.
//
// argv[1] is a font file, and every pair after it is a code point and a
// pixel size. tests/editor_ras.sh passes the same pairs to its own
// rasteriser and compares line for line.
ras_selftest(string[] argv) {
  int[] tt_bytes_v = tt_bytes(argv[1]);
  int ok = tt_load(tt_bytes_v);
  ras_selftest_go(argv, ok);
} return void;
(["prog", "test_assets/DejaVuSans.ttf"]):() then prints:("load 1\n")
(["prog", "test_assets/does-not-exist.ttf"]):() then traps:("id: index 0 out of bounds")

ras_selftest_go(string[] argv, int ok) {
  print("load " + ok);
  if(ok == 1) {
    ras_report(argv);
  }
} return void;
(["prog"], 0):() then prints:("load 0\n")
given tt_fixture (["prog", "test_assets/DejaVuSans.ttf", "65", "12"], 1):() then calls ras_report:[1]

ras_report(string[] argv) {
  int i = 2;
  while(i + 1 < len(argv)) {
    i = ras_shot(argv, i);
  }
} return void;
given tt_fixture (["prog", "test_assets/DejaVuSans.ttf", "65", "12"]):() then calls ras_shot:[1]
given tt_fixture (["prog", "test_assets/DejaVuSans.ttf", "65", "12", "66", "16"]):() then calls ras_shot:[2]
