// Whether the box the flattened outline produced has any area: a space has
// no contour, so ras_ink leaves ras_w()/ras_h() at 0 and this reports 0.
ras_scale_done(int ok) {
  if(ok == 1) {
    ras_ink();
  }
  int ret_i = ras_w() > 0 && ras_h() > 0;
} return int ret_i;
given ras_glyph_fixture (1):(1)
given ras_space_fixture (0):(0)

ras_met_upem(int[] tab) {
  int tt_upem_v = tt_upem();
  lset(tab, 1, tt_upem_v);
} return void;
given tt_fixture ([0, 0, 0, 0, 0, 0]):([0, 2048, 0, 0, 0, 0])
