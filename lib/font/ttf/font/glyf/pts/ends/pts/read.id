// The y run reads on from where the x run stopped, so the two calls cannot be
// reordered and the second cannot start until the first has finished.
tt_more(int[] tab, int[] row, int y) {
  tt_coords(tab, row, (import ttpy), 4, y);
  tt_oncurve(tab);
} return void;
