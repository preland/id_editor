tt_look1(int[] xs, int i) {
  tt_look1_go(xs, i);
  int ret_i = i + 1;
} return int ret_i;
given tt_fixture ([65, 103, 48, 32, 1046, 8211], 0):(1) then prints:("cp 65 g 36 adv 1401\n")
given tt_fixture ([65, 103, 48, 32, 1046, 8211], 4):(5) then prints:("cp 1046 g 939 adv 2206\n")

tt_look1_go(int[] xs, int i) {
  int g = tt_glyph(xs[i]);
  int tt_advance_v = tt_advance(g);
  print("cp " + xs[i] + " g " + g + " adv " + tt_advance_v);
} return void;
given tt_fixture ([65, 103, 48, 32, 1046, 8211], 0):() then prints:("cp 65 g 36 adv 1401\n")
