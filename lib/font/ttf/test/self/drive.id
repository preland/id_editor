// Takes an already-open handle. test/self/read/handle.id's tt_slurp_fixture
// reopens tt_io_fixture's file for reading, so a case can hand one in.
tt_slurp(int h, int[] xs) {
  int len_v = len(xs);
  fs_read(h, xs, len_v);
  fs_close(h);
} return void;
