// tt_selftest -- everything this parser claims, printed as one line per
// claim, so that a reference implementation can be asked the same questions
// and the two answers diffed. tests/editor_ttf.sh is that reference.
//
// It lives inside the module rather than beside the test script because the
// script has no way to call an `id` function: a program is a tree with a
// main, so the smallest thing that can exercise tt_glyph is a program, and
// the program's only interesting half belongs with the code it exercises.
tt_selftest(string[] argv) {
  int[] tt_bytes_v = tt_bytes(argv[1]);
  int ok = tt_load(tt_bytes_v);
  tt_selftest_go(ok);
} return void;
