tt_shape1_go(int[] xs, int i) {
  int g = tt_glyph(xs[i]);
  int ok = tt_outline(g);
  tt_shape1_print(xs, i, g, ok);
} return void;
given tt_fixture ([111, 65, 105, 233], 0):() then prints:("out 111 g 82 any 1 nc 2 np 24 bbox 113 -29 1141 1147 ends 11,23 on 100100100100100100100100\n")
given tt_fixture ([111, 65, 105, 233], 1):() then prints:("out 65 g 36 any 1 nc 2 np 11 bbox 16 0 1384 1493 ends 2,10 on 11111111111\n")

