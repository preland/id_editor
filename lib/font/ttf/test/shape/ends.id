// The contour ends and the on-curve flags, spelled out rather than counted:
// a rasteriser reads both of them literally, so both are what the reference
// has to agree with.
tt_endstr() {
  string[] names = [];
  tt_endsl(names);
  string ret_s = str_join(names, ",");
} return string ret_s;
given tt_outline_a ():("2,10")
given tt_outline_b ():("")

tt_endsl(string[] names) {
  int i = 0;
  while(i < len((import ttends))) {
    push(names, "" + (import ttends)[i]);
    i = i + 1;
  }
} return void;
given tt_outline_a ([]):(["2", "10"])
given tt_outline_b ([]):([])

tt_onstr() {
  string[] parts = [];
  tt_onsl(parts);
  string ret_s = str_join(parts, "");
} return string ret_s;
given tt_outline_a ():("11111111111")
given tt_outline_b ():("")
