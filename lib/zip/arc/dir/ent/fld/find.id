// Looking an entry up.

// -1 for a name that is not in the archive, which is a value rather than an
// abort: a document reader asks for entries that are optional -- a thumbnail,
// a settings file -- and has to be able to ask.
//
// xs is the archive the caller means. Only one archive is open at a time, so
// nothing reads it; taking it keeps the call site honest about which one.
zip_find(int[] xs, string name) {
  int[] buf = [0, -1];
  while (buf[0] < len((import zip_names)) && buf[1] < 0) {
    zip_hit(buf, name);
  }
  int ret_i = buf[1];
} return int ret_i;
given zip_init ([], "test"):(-1)
given zip_init ([], ""):(-1)

// buf is [where to look, what was found], the same pair zip_eocd uses, and
// for the same reason: the loop condition has to stop on a hit.
zip_hit(int[] buf, string name) {
  if ((import zip_names)[buf[0]] == name) {
    lset(buf, 1, buf[0]);
  }
  lset(buf, 0, buf[0] + 1);
} return void;
given zip_hit_fixture ([0, -1], "alpha"):([1, 0])
given zip_hit_fixture ([0, -1], "beta"):([1, -1])

// One name in the directory, so zip_hit has something at index 0 to compare
// against.
zip_hit_fixture() {
  zip_init();
  push((import zip_names), "alpha");
} return void;
():() then calls zip_init:[1]
():() then calls zip_init2:[1]
