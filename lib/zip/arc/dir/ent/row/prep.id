zip_entlen2(int[] xs, int at, int rd_le16_v, int rd_le16_v2) {
  int rd_le16_v3 = rd_le16(xs, at + 32);
  int ret_i = 46 + rd_le16_v + rd_le16_v2 + rd_le16_v3;
} return int ret_i;
