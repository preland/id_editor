zip_entlen(int[] xs, int at) {
  int rd_le16_v = rd_le16(xs, at + 28);
  int rd_le16_v2 = rd_le16(xs, at + 30);
  int ret_i = zip_entlen2(xs, at, rd_le16_v, rd_le16_v2);
} return int ret_i;
