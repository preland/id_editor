// The three checks and reads zip_ent makes before it can call zip_step:
// the signature, then the three field lengths that add up to the fixed part
// plus the name, the extra field and the comment.

zip_ent_prep(int[] xs, int at) {
  int zip_u32_v = zip_u32(xs, at);
  zip_sig(zip_u32_v, 33639248);
  int ret_i = zip_entlen(xs, at);
} return int ret_i;
