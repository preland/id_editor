// The counting and the walk that turns the counts into the symbol order.
inf_fill2(int[] xs, int[] tab, int[] row) {
  inf_count(xs, tab);
  int[] inf_starts_v = inf_starts(tab);
  inf_walk(xs, inf_starts_v, row);
} return void;
