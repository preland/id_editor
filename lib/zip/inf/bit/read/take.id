// Cell 0 is the value so far and cell 1 is how many bits are in it; a pair of
// plain locals cannot be used because the loop condition is outside the body.
inf_take(int[] xs) {
  int inf_bit_v = inf_bit();
  lset(xs, 0, xs[0] + (inf_bit_v << xs[1]));
  lset(xs, 1, xs[1] + 1);
} return void;

// A real DEFLATE stream, so that anything below inf_init has a legal `given`.
// It is one stored block -- BFINAL set, BTYPE 00, LEN 5, NLEN its complement,
// then "ABCDE" -- because a stored block is the only block whose bytes can be
// written out by hand and checked by eye.
inf_stream_fixture() {
  int[] src = [1, 5, 0, 250, 255, 65, 66, 67, 68, 69];
  inf_init(src, 0);
} return void;
():() then inf_bit:(1)
():() then calls inf_init:[1]

// The stream and the length/distance tables together: a match reads both, and
// a `given` names one function, so the pair has to be composed here.
inf_ready() {
  inf_stream_fixture();
  inf_tabs();
} return void;
():() then inf_bit:(1)
():() then calls inf_tabs:[1]
