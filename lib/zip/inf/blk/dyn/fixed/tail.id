// The same block type carrying a back-reference: one literal "A" and a match
// of length nine at distance one. It is the shortest stream that reaches
// inf_match at all, which no stored block can do.
inf_match_stream() {
  int[] src = [115, 116, 132, 1, 0];
  inf_init(src, 0);
  inf_tabs();
} return void;
