// A fixed-Huffman block -- BTYPE 01 -- holding the single literal "A". The
// codes are the ones RFC 1951 section 3.2.6 fixes rather than ones the stream
// carries, so the three bytes can be written out here: literal 65 is the
// eight-bit code 0x30 + 65, and end-of-block is seven zero bits.
inf_fixed_a() {
  int[] src = [115, 4, 0];
  inf_init(src, 0);
} return void;
