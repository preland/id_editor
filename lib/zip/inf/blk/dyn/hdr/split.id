// The rest of inf_dyn, once the code-length tree has read the run of lengths.
inf_dyn2(int[] xs, int[][] rows) {
  int[] buf = inf_lens(rows[0], rows[1], xs[0] + xs[1]);
  inf_split(buf, xs[0], xs[1]);
} return void;

// Fixture: initialize inflation state with byte [1] at offset 0.
inf_init_one() {
  int[] src = [1];
  inf_init(src, 0);
} return void;
():() then calls inf_init:[1]
():() then inf_bit:(1)

