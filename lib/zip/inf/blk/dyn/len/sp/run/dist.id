// The fixed distance alphabet: thirty five-bit codes. Two more codes exist in
// the fixed tree and are never valid, and leaving them out means a stream that
// uses one aborts here rather than indexing an empty entry in the base table.
inf_fix_dist() {
  int[] xs = [];
  lst_fill(xs, 30, 5);
} return int[] xs;

// A dynamic-Huffman block -- BTYPE 10 -- whose code lengths are in the stream
// rather than in the standard. Sixty-six bytes expand to three hundred and
// four, and nothing shorter exercises inf_clens and inf_lens at all.
inf_dyn_stream() {
  int[] src = [229, 204, 193, 13, 128, 32, 12, 5, 208, 85, 254, 4, 238, 84, 161, 192, 143, 77, 33, 80, 226, 250, 94, 60, 184, 131, 231, 151, 60, 102, 112, 65, 96, 226, 117, 75, 85, 220, 140, 134, 104, 83, 21, 146, 130, 221, 23, 134, 78, 156, 214, 211, 5, 241, 252, 90, 217, 254, 209, 66, 211, 3, 252, 193, 245, 0];
  inf_init(src, 0);
  inf_tabs();
} return void;
():() then inf_bit:(1)
