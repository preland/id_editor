// A block header: one BFINAL bit, then two bits of type.

// The two reads are separate statements because both move the bit position
// and the order they happen in is the format.
inf_block(int[] xs) {
  int inf_bits_v = inf_bits(1);
  lset(xs, 0, inf_bits_v);
  inf_block2();
} return void;
given inf_stream_fixture ([0, 0, 0]):([1, 0, 0])
given inf_empty_block ([0, 0, 0]):([1, 0, 0])

// BTYPE, read once BFINAL is out of the way.
inf_block2() {
  int inf_bits_v2 = inf_bits(2);
  inf_kind(inf_bits_v2);
} return void;
given inf_block2_ready ():() then inf_outlen:(5)
given inf_block2_empty ():() then inf_outlen:(0)

// Split in two only because an `if` with three `else` clauses is four actions
// and the limit is three.
inf_kind(int n) {
  if (n == 0) {
    inf_stored();
  } else {
    inf_comp(n);
  }
} return void;
