// Type 3 is reserved by RFC 1951 and means the stream is not DEFLATE, or is
// not aligned where the caller thought it was.
inf_comp(int n) {
  if (n == 1) {
    inf_fixed();
  } else if (n == 2) {
    inf_dynamic();
  } else {
    inf_fail("deflate: reserved block type 3");
  }
} return void;

// How many bytes the decoder has produced. A case cannot name an exported list
// as a check's value, so the one observable fact about inf_out -- that a block
// emitted what it should have -- needs a reader of its own.
inf_outlen() {
  int n = len((import inf_out));
} return int n;
